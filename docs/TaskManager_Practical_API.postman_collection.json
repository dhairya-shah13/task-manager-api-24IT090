				{
					"name": "P10-3. Create Task (Emits task-created AFTER 201)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Response time under 500 ms (notification did NOT block)', function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(500);",
									"});",
									"pm.test('Body has title and user', function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data).to.have.property('title');",
									"    pm.expect(data).to.have.property('user');",
									"});",
									"pm.test('Save taskId for later requests', function () {",
									"    var data = pm.response.json();",
									"    pm.environment.set('taskId', data._id);",
									"    pm.globals.set('taskId', data._id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Practical 10 Event Demo Task\",\n  \"description\": \"Emits task-created after the 201 response is sent\",\n  \"priority\": \"high\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/tasks",
							"host": ["{{baseUrl}}"],
							"path": ["tasks"]
						}
					},
					"response": []
				},
