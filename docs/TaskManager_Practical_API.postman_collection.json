					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    if (data.token) {",
									"        pm.environment.set('token', data.token);",
									"        pm.globals.set('token', data.token);",
									"    }",
									"}"
								],
